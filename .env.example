# Copy to .env and fill in. Never commit the real .env.

# Neon Postgres connection string (pgvector enabled). Neon's default URL works as-is.
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# Signs login session cookies. Any long random string locally; Render generates one in prod.
# e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string

# development | production (production = Secure cookies + JWT_SECRET required)
ENV=development

# Only for tests: local docker compose Postgres (docker compose up -d db)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mwda_test
